PORT=4000

# JWT (optional locally — falls back to built-in dev secret)
# JWT_SECRET=change-me-in-production

# Production / Render — set this on the web service (Internal Database URL)
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/construction_erp

# Optional: force SSL when using DB_* (Render always needs TLS)
# DB_SSL=true

DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your_password
DB_NAME=construction_erp
